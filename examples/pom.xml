<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pderop</groupId>
        <artifactId>looma-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>looma-examples</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.github.pderop</groupId>
            <artifactId>looma-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>5.6.2</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Writes the runtime dependencies of this module to target/classpath.txt, for the
                scripts that launch `java` directly (taskset/perf must not have a build tool in
                between). The module's own classes are NOT in it: use
                    CP=examples/target/classes:$(cat examples/target/classpath.txt)
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>build-classpath</id>
                        <phase>package</phase>
                        <goals><goal>build-classpath</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/classpath.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        The scheduler module only builds on the Loom JDK (root pom, same activation), so the
        dependency on it is profile-scoped too: on JDK 25 it is simply absent, target/classpath.txt
        does not name it, and the example runs on the ForkJoinPool fallback. Runtime scope on
        purpose: nothing here compiles against it, the ServiceLoader finds it or it does not.
    -->
    <profiles>
        <profile>
            <id>loom-jdk</id>
            <activation><jdk>[28,)</jdk></activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.pderop</groupId>
                    <artifactId>looma-netty-scheduler</artifactId>
                    <version>${project.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
